# Copy to .env.local and fill in real values. Never commit real secrets.

# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Upstash Redis (per-IP rate limiting on create, join, come-back).
# Optional locally: if missing, the IP limit is skipped. Required in production.
# (Vercel's Upstash integration names KV_REST_API_URL / KV_REST_API_TOKEN also work.)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# PostHog (product analytics, safe to expose to the browser)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
