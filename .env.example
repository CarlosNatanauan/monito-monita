# Copy to .env.local and fill in real values. Never commit real secrets.

# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Upstash Redis (per-IP rate limiting on create, join, come-back).
# Optional locally: if missing, the IP limit is skipped. Required in production.
# (Vercel's Upstash integration names KV_REST_API_URL / KV_REST_API_TOKEN also work.)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# PostHog (product analytics, sent from the server only; see docs/TECH.md).
# Optional: if POSTHOG_KEY is missing (local dev), nothing is tracked.
POSTHOG_KEY="phc_your_project_key"
# US cloud by default; use https://eu.i.posthog.com for an EU project.
POSTHOG_HOST="https://us.i.posthog.com"

# The app's own address, used for every link people see, copy or share,
# and for share images. Set it in Vercel for Production only
# (https://monitomonita-ph.vercel.app); leave it unset locally and on
# previews so links use the address the page was opened on.
NEXT_PUBLIC_SITE_URL=""

# Vercel Cron (vercel.json): the daily job that deletes expired demo groups
# sends "Authorization: Bearer <CRON_SECRET>". At least 16 characters, e.g.
# `openssl rand -hex 32`. Set it in Vercel (Production). Without it the job
# is refused (expired demos are still cleaned up when a new demo starts).
CRON_SECRET=""
